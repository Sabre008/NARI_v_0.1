# ── N.A.R.I  Environment Configuration ──
# Copy this file to `.env` for local execution.
# NEVER commit `.env` or any secrets file to version control.
#
# FOR GITHUB CODESPACES:
#   Set these in GitHub Repository Settings > secrets and variables > Codespaces.
#   GitHub automatically injects them as environment variables inside your container.
#
# FOR STREAMLIT CLOUD:
#   Add these to your Streamlit App Settings > secrets (or `.streamlit/secrets.toml`).

# ── Supabase Credentials ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Application Environment ───────────────────────────────
NARI_ENV=development          # development | staging | production
NARI_LOG_LEVEL=INFO           # DEBUG |INFO |WARNING| ERROR

# ── FastAPI ─────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── Backend API Override (Optional) ───────────────────────
# Leave blank for automatic dynamic resolution:
# - Localhost: defaults to http://127.0.0.1:8000
# - GitHub Codespaces: automatically resolves https://${CODESPACE_NAME}-8000.app.github.dev
# Override only if deploying behind a custom domain or custom reverse proxy.
API_URL=

# ── Model Path──────────────────────
SAFETY_NET_WEIGHTS=models/safety_dnn/weights/safety_net.pth
